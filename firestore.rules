rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Each inspection belongs to exactly the inspector (Firebase Auth uid) who
    // created it — a personal account, no shared company/organization scope.
    function isOwner(inspectorId) {
      return isSignedIn() && request.auth.uid == inspectorId;
    }

    // inspections/{inspectionId} — the core data isolation boundary. A user may
    // only read/write inspections whose inspectorId matches their own uid.
    match /inspections/{inspectionId} {
      allow read: if isOwner(resource.data.inspectorId);
      allow create: if isOwner(request.resource.data.inspectorId);
      allow update: if isOwner(resource.data.inspectorId)
                    && isOwner(request.resource.data.inspectorId);
      allow delete: if isOwner(resource.data.inspectorId);

      match /errorItems/{errorItemId} {
        allow read, write: if isOwner(
          get(/databases/$(database)/documents/inspections/$(inspectionId)).data.inspectorId
        );
      }
    }

    // report_delivery_queue/{taskId} — written by the app, read/processed by the
    // processReportQueue Cloud Function (admin SDK, bypasses rules). The task payload
    // itself has no inspectorId field (see ReportDeliveryQueueService.TaskPayload), so
    // ownership is checked by looking up the referenced inspection instead.
    function ownsQueuedInspection(inspectionId) {
      return isOwner(get(/databases/$(database)/documents/inspections/$(inspectionId)).data.inspectorId);
    }
    match /report_delivery_queue/{taskId} {
      allow read: if ownsQueuedInspection(resource.data.inspectionId);
      allow create: if ownsQueuedInspection(request.resource.data.inspectionId);
      allow update, delete: if false;
    }
  }
}
